{
  "name": "niustats",
  "private": true,
  "description": "Battery range statistics for Niu electric scooters",
  "homepage": "https://niustats.com",
  "repository": "github:karolszklarski/niustats",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "serve": "node scripts/serve.js",
    "vendor": "node scripts/vendor.js",
    "test": "npm run test:unit && npm run test:php && npm run test:e2e",
    "test:unit": "node --test \"tests/unit/*.test.js\"",
    "test:php": "node --test --test-concurrency=1 \"tests/php/*.test.js\"",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "blueimp-md5": "2.19.0",
    "bootstrap": "5.3.2",
    "chart.js": "4.5.1",
    "vanilla-cookieconsent": "3.1.0"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1"
  }
}
