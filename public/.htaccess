Options -MultiViews -Indexes

RedirectMatch 404 (^|/)\.git(/|$)

<IfModule mod_headers.c>
    Header set Cache-Control "no-cache"
    Header unset Expires

    Header always set Strict-Transport-Security "max-age=31536000"
    Header always set X-Content-Type-Options "nosniff"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Cross-Origin-Opener-Policy "same-origin"
    Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
    Header always set Content-Security-Policy "default-src 'self'; script-src 'self' https://www.googletagmanager.com; connect-src 'self' https://account-fk.niu.com https://app-api-fk.niu.com https://www.googletagmanager.com https://*.google-analytics.com https://*.google.com; img-src 'self' https://www.googletagmanager.com https://*.google-analytics.com; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'self'"
    Header unset X-Powered-By
    Header always unset X-Powered-By
</IfModule>

RewriteEngine on
RewriteCond %{HTTPS} !on [OR]
RewriteCond %{HTTP_HOST} ^www\..+$ [NC]
RewriteRule ^(.*)$ https://niustats.com/$1 [R=301,L]
